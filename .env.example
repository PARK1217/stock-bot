# ===== 실행 모드 =====
# paper = 모의투자(기본, 안전), live = 실전투자
TRADING_MODE=paper
# 사용할 증권사: kis | toss
BROKER=kis

# ===== 한국투자증권 KIS Developers =====
# 모의/실전 앱키가 각각 다름 (apiportal.koreainvestment.com). TRADING_MODE 로 자동 선택.
# --- 모의투자 (paper) ---
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=     # 계좌번호 앞 8자리 (CANO)
KIS_PAPER_ACCOUNT_PROD=01 # 상품코드 뒤 2자리, 보통 01
# --- 실전투자 (live) ---
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=
KIS_LIVE_ACCOUNT_PROD=01

# ===== 뉴스/감성 (예측 보강, 나중에 발급) =====
FINNHUB_API_KEY=         # 미국 종목 뉴스 (finnhub.io 무료)
DART_API_KEY=            # 한국 전자공시 (opendart.fss.or.kr 무료)
ANTHROPIC_API_KEY=       # LLM 감성분석 (없으면 키워드 폴백)

# ===== 토스증권 Open API =====
TOSS_APP_KEY=            # CLIENT_ID
TOSS_APP_SECRET=         # CLIENT_SECRET
TOSS_ACCOUNT_NO=         # X-Tossinvest-Account 헤더용 계좌번호
# 토스는 모의투자 환경이 없을 수 있음 → 실거래 주문은 아래를 true로 명시해야 나감
TOSS_ALLOW_LIVE=false

# --- 남편(배우자) 토스 계좌: 대시보드 '남편' 사용자탭용 ---
# 남편 본인 명의로 openapi.tossinvest.com 에서 발급한 별도 앱키/시크릿.
TOSS_SPOUSE_APP_KEY=         # 남편 CLIENT_ID
TOSS_SPOUSE_APP_SECRET=      # 남편 CLIENT_SECRET
TOSS_SPOUSE_ACCOUNT_NO=      # 남편 토스 계좌번호

# ===== DB / Redis =====
DB_USER=stockbot
DB_PASSWORD=changeme
DB_NAME=stockbot
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://stockbot:changeme@db:5432/stockbot
REDIS_URL=redis://redis:6379/0

# ===== 알림 =====
DISCORD_WEBHOOK_URL=     # 디스코드 채널 웹훅 URL (모니터링, 권장)
TELEGRAM_BOT_TOKEN=      # (폴백, 선택)
TELEGRAM_CHAT_ID=

# ===== 리스크 룰 =====
MAX_POSITION_PCT=20      # 종목당 최대 비중(%)
DAILY_ORDER_LIMIT=10     # 일일 최대 주문 건수
STOP_LOSS_PCT=15         # 손절선(%)
